# Copy this file to ".env" and adjust. Every value is optional.

# Database. Leave unset to use a local SQLite file (server/rec_app.db).
# DATABASE_URL=mysql+pymysql://root:your_password@localhost:3306/rec_app

# Secret used to sign login tokens. Leave unset to have one generated
# automatically (stored in server/.jwt_secret, which is git-ignored).
# JWT_SECRET_KEY=change-me-to-a-long-random-string

# ACCESS_TOKEN_EXPIRE_MINUTES=1440
# MAX_UPLOAD_MB=10
# MODEL_PATH=best.pt
# SQL_ECHO=0
